# Point the frontend at a running ClariFi backend.
#
# Local development:
VITE_API_URL=http://localhost:8000
#
# Production (Vercel): set this in the Vercel project's Environment
# Variables to your deployed Render backend URL, e.g.
# VITE_API_URL=https://your-render-backend.onrender.com
#
# Do NOT put GEMINI_API_KEY, TAVILY_API_KEY, DATABASE_URL, or any Supabase server secret
# secret here or in Vercel — those belong only in the backend's
# environment on Render (see backend/.env.example).
