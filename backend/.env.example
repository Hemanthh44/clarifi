# Copy this file to backend/.env for local development. Never commit a filled-in .env.

# ---------------------------------------------------------------------
# Database — use the Supabase Connect dialog. For Render, use the
# Supavisor Session pooler URI (port 5432), not the direct IPv6 URI.
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.<PROJECT-REF>:<PASSWORD>@<SESSION-POOLER-HOST>:5432/postgres

# ---------------------------------------------------------------------
# Supabase Storage — server-only credentials.
# Create a private bucket named clarifi-documents in Supabase Storage.
# SUPABASE_SERVICE_ROLE_KEY is the legacy elevated server key; if your
# project exposes the newer secret key instead, SUPABASE_SECRET_KEY is
# also accepted by the backend.
# ---------------------------------------------------------------------
SUPABASE_URL=https://<PROJECT-REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_secret_key
SUPABASE_STORAGE_BUCKET=clarifi-documents

# ---------------------------------------------------------------------
# Authentication — REQUIRED in production.
# Signing key for the JWTs issued by /api/auth/login and /api/auth/signup.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In development this may be left blank: the backend generates a random
# per-process secret, which means restarting the server logs everyone out.
# Changing this value in production invalidates all existing sessions.
# ---------------------------------------------------------------------
CLARIFI_JWT_SECRET=
# Token lifetime in seconds (default 43200 = 12 hours).
CLARIFI_JWT_EXPIRE_SECONDS=43200

# ---------------------------------------------------------------------
# LLM (Gemini) — optional.
# ---------------------------------------------------------------------
GEMINI_API_KEY=
CLARIFI_LLM_MODEL=gemini-2.5-flash-lite

# ---------------------------------------------------------------------
# Web search (Tavily) — optional.
# ---------------------------------------------------------------------
TAVILY_API_KEY=
CLARIFI_TAVILY_MAX_RESULTS=6

# ---------------------------------------------------------------------
# CORS — deployed Vercel frontend origin.
# ---------------------------------------------------------------------
CLARIFI_FRONTEND_ORIGIN=http://localhost:5173
